# Trading mode: paper | testnet | live
TRADING_MODE=paper

# Signal mode: production | test_fast
SIGNAL_MODE=test_fast

# Binance Futures Testnet credentials.
# Create these on Binance Futures Testnet, not on the live Binance account.
# Strategy signals use production public market data from https://fapi.binance.com.
# Testnet credentials are only used for simulated execution orders.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance Futures live credentials.
# Keep withdrawal disabled on the Binance API key.
# Live execution is blocked unless ALLOW_LIVE_TRADING and LIVE_ORDER_CONFIRMATION
# are both explicitly set below.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Position sizing and paper/testnet/live limits.
POSITION_MARGIN_USDT=10
MAX_OPEN_POSITIONS=10

# Production signal schedule remains Beijing 00:00 / 08:00.
# test_fast checks entry signals every N minutes for execution-flow testing only.
SIGNAL_TEST_INTERVAL_MINUTES=5

# Optional FR3/YR1 Bucket B Rank3 regime overlay.
# Keep false to use the base main-strategy leverage mapping.
# Set true only after replay/tests are accepted. When true, live/testnet daemon
# auto-generates context before 00:00/08:00 signal evaluation.
RANKPULSE_REGIME_ENABLED=false
RANKPULSE_REGIME_CONTEXT_AUTO_GENERATE=true
# Optional audit JSON output path. Leave blank to let runtime use
# data/<trading_mode>/<signal_mode>/regime_context.json.
# When Regime is enabled, stale/missing/non-READY context is rejected instead of falling back silently.
RANKPULSE_REGIME_CONTEXT_PATH=

# Rank1 Candidate first-start bootstrap.
# Historical data is used only to rebuild virtual open-position state.
# It never backfills real orders. Leave activation blank to use the first run time.
RANK1_BOOTSTRAP_ENABLED=true
RANK1_ACTIVATION_TIME_MS=
RANK1_BOOTSTRAP_STRATEGY_VERSION=rank1_candidate_v1

# 12H weak exit is part of the main strategy and defaults to true.
ENABLE_12H_WEAK_EXIT=true

# test_fast compressed exit timing. These do not change production defaults.
TEST_WEAK_EXIT_AFTER_MINUTES=15
TEST_PLANNED_EXIT_AFTER_MINUTES=60

# Safety lock. Must be set to false to allow any execution-mode run.
# This prevents accidental execution before reading the docs.
ENFORCE_SAFETY_LOCK=true

# Live order guard. Keep disabled by default.
ALLOW_LIVE_TRADING=false
LIVE_ORDER_CONFIRMATION=

# Optional Telegram notifications. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
